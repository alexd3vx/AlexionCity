{
  "name": "alexioncity",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:client": "pnpm --filter @alexioncity/client dev",
    "dev:server": "pnpm --filter @alexioncity/server dev",
    "dev:admin": "pnpm --filter @alexioncity/admin dev",
    "dev": "pnpm --parallel --filter @alexioncity/client --filter @alexioncity/server dev",
    "e2e": "node tools/e2e-multiplayer.mjs",
    "e2e:life": "node tools/e2e-life.mjs",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "assets:validate": "pnpm --filter @alexioncity/asset-tools validate",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "assets:build": "pnpm --filter @alexioncity/asset-tools cli build --root ../../assets-src --out ../../packs-out --game-version 0.0.1",
    "perf": "node tools/perf-check.mjs",
    "check:db": "node tools/live-db-check.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "sharp": "^0.35.5",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "playwright": "1.63.0"
  }
}
