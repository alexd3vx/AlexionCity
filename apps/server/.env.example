# Game server environment. Copy to .env.local for local runs; on a host, set these in its dashboard.
# The secret key bypasses all database security. It lives ONLY here: never in apps/client, never in git.

PORT=8787
# Comma-separated page origins allowed to open a socket (required in production)
ALLOWED_ORIGINS=http://localhost:5173

# With both of these the server checks sign-in tokens and saves reports, blocks and chat. Leave them out to
# run in memory for testing. Phase 3 also uses them to pay and charge players through apply_ledger
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Supabase "secret" key (sb_secret_...), the newer name for the service_role key
SUPABASE_SECRET_KEY=sb_secret_xxx

# Accept made-up guest ids without Supabase. On by default outside production; never turn on for a public server
# ALLOW_DEV_GUESTS=1
