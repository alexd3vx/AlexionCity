# Copy to .env.local for local development. On your host (for example Cloudflare Pages) set the same
# variables in its dashboard. Only values that are safe to publish belong here: everything with a VITE_
# prefix ends up in the browser. Never put a Supabase secret or service_role key in this file.

# Supabase project URL and publishable (formerly "anon") key
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Game server WebSocket URL
VITE_GAME_WS_URL=ws://localhost:8787

# Where asset packs and manifest.json are served from (a CDN or storage URL when deployed)
VITE_ASSET_BASE=/packs
